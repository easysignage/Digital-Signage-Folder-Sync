# API key from the CMS: Settings → API Keys (Premium / Enterprise plans).
# Needs media, playlists and displays permissions.
EASYSIGNAGE_API_KEY=ds_api_...
# White-label accounts only: your own API host.
# EASYSIGNAGE_BASE_URL=

# The playlist the folder is mirrored into. `npm run setup` creates one and fills this in.
PLAYLIST_ID=
# `npm run setup` assigns the playlist to the screens carrying this tag.
SCREEN_TAG=automation

# The folder to watch, relative to this project.
WATCH_DIR=./content
# Seconds each image is shown. Videos play for their own length.
DEFAULT_DURATION=10
# Wait this long after the last change before syncing, so a batch of files publishes once.
DEBOUNCE_MS=3000
# What happens to a removed file's media: delete it, or only take it out of the playlist.
DELETE_MODE=delete
PORT=3001
